---
import { Image } from "astro:assets";
import { resolveAsset } from "../lib/assets";
import type { Projet } from "../lib/db";

interface Props {
    projet: Projet;
}

const { projet } = Astro.props;
const famille =
    projet.id_categorie === 2
        ? "site-web"
        : projet.id_categorie === 3
          ? "affiche"
          : "autre";
---

<a
    href={`/projet/${projet.id_projet}`}
    data-groupe={String(projet.en_groupe === 1)}
    data-famille={famille}
    class="card card-projet h-full rounded-none border-2 border-black bg-base-300 text-white
         transition-transform hover:-translate-y-1"
>
    <figure class="aspect-[3/2] overflow-hidden">
        <Image
            src={resolveAsset(projet.image_couverture)}
            alt={projet.alt_image || projet.titre}
            class="h-full w-full object-cover"
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
        />
    </figure>
    <div class="card-body flex-1 gap-1 p-3">
        <div class="flex items-baseline justify-between gap-4">
            <h3 class="card-title min-w-0 font-display uppercase text-action">
                {projet.titre}
            </h3>
            <span class="shrink-0 font-label text-micro">{projet.annee}</span>
        </div>
        <p class="text-base leading-snug">{projet.description_courte}</p>
    </div>
</a>
