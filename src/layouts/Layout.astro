---
import "../styles/global.css";
interface Props {
	title?: string;
}

const { title = "Mon portfolio" } = Astro.props;

import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="fr" data-theme="mytheme">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Arsenal+SC:wght@400;700&family=Inter:wght@400;500;600&family=Roboto:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-primary font-body text-black min-h-screen overflow-x-hidden">
		<slot />
		<Footer />
	</body>
</html>
