---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout
	title="Page introuvable"
	description="La page que vous cherchez n'existe plus ou a été déplacée."
>
	<Header/>
	<section
		class="flex flex-1 flex-col justify-center bg-primary px-6 py-16 lg:pl-36"
	>
		<p class="text-lg uppercase text-base-content/70">Page introuvable</p>

		<p
			class="text-[clamp(6rem,20vw,16rem)] font-display leading-none text-base-content-300"
			aria-hidden="true"
		>
			404
		</p>

		<h1 class="mt-6 text-sm body-light">
			Il semblerait que cette page ait perdu son chemin.
		</h1>

		<p class="mt-5 text-lg">
			La page que vous cherchez n'existe plus ou a été déplacée.
		</p>

		<a
			href="/"
			class="mt-2 min-h-10 w-fit border-2 border-black bg-white px-8 font-display text-base font-bold uppercase transition-colors hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
		>
			retourner à l'accueil
		</a>
	</section>
</Layout>

<style>
	:global(body) {
		display: flex;
		flex-direction: column;
	}
</style>
